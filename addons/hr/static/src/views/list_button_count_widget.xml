<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr.ListButtonCountWidget">
        <button
            class="btn oe_stat_button btn-outline-secondary d-inline-flex align-items-center"
            t-on-click="onClick"
            type="button"
        >
            <i t-if="icon" t-attf-class="fa {{icon}} o_button_icon"/>
            <span class="o_stat_value ms-2">
                <t t-esc="displayValue"/>
            </span>
        </button>
    </t>
</templates>
