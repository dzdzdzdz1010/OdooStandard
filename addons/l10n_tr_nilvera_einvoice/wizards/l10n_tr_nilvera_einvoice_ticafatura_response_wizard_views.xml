<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="l10n_tr_nilvera_einvoice.ticafatura_response_wizard_form" model="ir.ui.view">
            <field name="name">l10n_tr_nilvera_einvoice.ticafatura.response.wizard.form</field>
            <field name="model">l10n_tr_nilvera_einvoice.ticafatura.response.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <field name="response_note" nolabel="1" placeholder="Enter reason for rejection..."/>
                    <footer>
                        <button string="Reject" name="action_reject" type="object" class="oe_highlight" data-hotkey="q"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
