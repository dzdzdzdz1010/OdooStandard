<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_l10n_vn_edi_pos" model="ir.ui.view">
        <field name="name">res.company.form.inherit.l10n_vn_edi_pos</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="after">
                <page string="SInvoice" name="sinvoice" invisible="country_code != 'VN'">
                    <group>
                        <field name="l10n_vn_pos_default_symbol"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
