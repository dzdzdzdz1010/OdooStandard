<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="mail.ChatterComposer" t-inherit="mail.Composer" t-inherit-mode="primary">
        <xpath expr="//div[@t-ref='root']" position="before">
            <t t-if="props.type === 'message'">
                <div class="d-flex pt-1">
                    <span class="flex-shrink-0 text-end fw-bold" style="width:55px">To: </span>
                    <RecipientsInput thread="props.thread"/>
                </div>
                <div class="d-flex pb-1">
                    <span class="flex-shrink-0 text-end fw-bold me-1" style="width:55px">Subject: </span>
                    <input t-ref="subjectInput" type="text" name="subject" class="o_input border-0" t-att-placeholder="props.thread.default_subject"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>

