<odoo>
    <data>
        <template id="email_designer_snippets" inherit_id="mass_mailing.email_designer_snippets">
            <xpath expr="//t[@t-snippet='mass_mailing.s_product_list']" position="after">
                <t t-snippet="mass_mailing_sale.s_products" group="columns" label="Dynamic Content" string="Products List"/>
                <t t-snippet="mass_mailing_sale.s_product_card" group="images" label="Dynamic Content" string="Product"/>
                <t t-snippet="mass_mailing_sale.s_product_aside" group="images" label="Dynamic Content" string="Product"/>
            </xpath>
        </template>
    </data>
</odoo>
