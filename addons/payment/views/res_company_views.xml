<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.form.payment</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Payment" name="payment_configuration">
                    <group>
                        <group name="payment_labels" string="Payment Button Labels">
                            <field name="direct_payment_label"/>
                            <field name="delayed_payment_label"/>
                        </group>
                    </group>
                </page>
            </xpath>
            
            </field>
    </record>
</odoo>
