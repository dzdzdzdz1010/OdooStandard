<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <template id="point_of_sale.pos_tip_receipt">
            <html id="pos-receipt">
                <head>
                    <meta charset="UTF-8"></meta>  <!--  Needed for wkhtmltoimage to render UTF-8 characters properly -->
                    <t t-call="point_of_sale.pos_order_receipt_style" />
                </head>
                <body>
                    <div class="pos-receipt">
                        <div class="w-100 text-center mb-3" name="logo">
                            <img t-if="image['logo']" t-att-src="image['logo']" style="max-height: 75px" />
                        </div>
                        <div class="text-large text-center">
                            <span t-esc="extra_data['date']" />
                        </div>
                        <div class="text-large text-center text-bold">
                            Tip Receipt
                        </div>
                        <div t-if="extra_data.get('name')" class="pos-payment-terminal-receipt mb-2">
                            <pre t-esc="extra_data['name']" />
                        </div>

                        <table class="w-100 mb-3 text-large">
                            <tbody>
                                <tr>
                                    <td class="text-start w-70" name="subtotal">Subtotal:</td>
                                    <td class="text-end w-30"><t t-out="extra_data['prices']['subtotal_amount']" /></td>
                                </tr>
                                <tr class="text-bold">
                                    <td class="text-start w-70" name="total">Total:</td>
                                    <td class="text-end w-30"><span class="total-amount font-monospace" t-out="extra_data['prices']['total_amount']" /></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="mb-3 w-100 text-large">
                            <tbody>
                                <tr>
                                    <td class="text-start">Tip:</td>
                                    <td class="text-end">________________________</td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="mb-3 w-100 text-large">
                            <tbody>
                                <tr>
                                    <td class="text-start">Total:</td>
                                    <td class="text-end">________________________</td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="mb-3 w-100 text-large">
                            <tbody>
                                <tr>
                                    <td class="text-start">Signature:</td>
                                    <td class="text-end">________________________</td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="w-100 text-small mt-3">
                            <tbody name="company_info">
                                <tr>
                                    <td class="text-start" t-out="company['name']" />
                                    <td class="text-end">
                                        Tel. <t t-out="company['phone']" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-start">
                                        <t t-out="company['street']" />
                                        <t t-if="company['street2']" t-out="company['street2']" />
                                    </td>
                                    <td class="text-end" t-out="company['email']" />
                                </tr>
                                <tr>
                                    <td class="text-start">
                                        <t t-out="company['zip']" /> <t t-out="company['city']" />,
                                        <t t-out="extra_data['company_state_name']" />
                                    </td>
                                    <td class="text-end" t-out="company['website']" />
                                </tr>
                                <tr>
                                    <td class="text-start" t-if="company.get('vat')" name="company_info_vat">
                                        VAT: <t t-out="company['vat']" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </body>
            </html>
        </template>
    </data>
</odoo>
