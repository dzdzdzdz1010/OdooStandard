<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="project.ProjectColorStatusSelection" t-inherit="web.SelectionField" t-inherit-mode="primary">
        <xpath expr="//t[@t-if='props.readonly']/span" position="replace">
            <div class="px-1 px-md-2">
                <span t-attf-class="o_status {{ statusColor(currentValue) }} d-inline-block"/>
            </div>
        </xpath>
    </t>

    <t t-name="project.ProjectColorStatus" t-inherit="web.CharField" t-inherit-mode="primary">
        <xpath expr="//t[@t-if='props.readonly']/span" position="replace">
            <div class="px-1 px-md-2">
                <span t-attf-class="o_status {{ statusColor(currentValue) }} d-inline-block"/>
            </div>
        </xpath>
    </t>

</templates>
