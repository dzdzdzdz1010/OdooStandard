<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_pivot_inherit_sale_timesheet_project" model="ir.ui.view">
        <field name="name">Actual Analytic Margins per Project</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="account.view_account_analytic_line_pivot"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="type">row</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="timesheet_invoice_type" type="col"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_line_pivot_inherit_sale_timesheet" model="ir.ui.view">
        <field name="name">Projects Actual Analytic Margins</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="sale_timesheet.view_account_analytic_line_pivot_inherit_sale_timesheet_project"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="replace">
                <field name="project_id" type="row"/>
            </xpath>
        </field>
    </record>

    <record id="action_analytic_reporting_inherit_sale_timesheet" model="ir.actions.act_window">
        <field name="name">Actual Analytic Margins</field>
        <field name="res_model">account.analytic.line</field>
        <field name="path">project-margins</field>
        <field name="search_view_id" ref="account.view_account_analytic_line_filter_inherit_account"/>
        <field name="view_id" ref="sale_timesheet.view_account_analytic_line_pivot_inherit_sale_timesheet"/>
        <field name="view_mode">pivot,list,kanban,graph,grid</field>
        <field name="context">{
            'search_default_group_by_analytic_account': 1,
            'search_default_fiscal_date': 1,
        }</field>
    </record>
</odoo>
