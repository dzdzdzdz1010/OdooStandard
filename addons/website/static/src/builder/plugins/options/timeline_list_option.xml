<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="website.TimelineListOption">
    <BuilderRow label.translate="Milestones">
        <BuilderButton
            type="'success'"
            action="'addItem'"
            actionParam="'.s_timeline_list_row'"
            actionValue="'beforebegin'"
            preview="false"
            applyTo="':scope > :has(.s_timeline_list_row)'">
            Add Milestone
        </BuilderButton>
    </BuilderRow>

    <BuilderRow label.translate="Alignment">
        <BuilderButtonGroup applyTo="'.s_timeline_list_wrapper'">
            <t t-set="left">Align Left</t>
            <t t-set="right">Align Right</t>
            <BuilderButtonLtrRtl position="'start'"
                label="{ left: left, right: right }"
                icon="'fa-align-left'"
                classAction="{ primary: 'justify-content-start', secondary: 'justify-content-end' }"/>
            <BuilderButton icon="'fa-align-center'" title.translate="Align Center" classAction="'justify-content-center'"/>
            <BuilderButtonLtrRtl position="'end'"
                label="{ left: left, right: right }"
                icon="'fa-align-right'"
                classAction="{ primary: 'justify-content-end', secondary: 'justify-content-start' }"/>
        </BuilderButtonGroup>
    </BuilderRow>
</t>

</templates>
