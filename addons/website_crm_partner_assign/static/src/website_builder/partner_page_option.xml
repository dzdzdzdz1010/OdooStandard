<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="website_crm_partner_assign.PartnerPageOption">
        <BuilderRow label.translate="Contact Details">
            <BuilderCheckbox action="'websiteConfig'" actionParam="{views: ['website_crm_partner_assign.contact_details']}" />
        </BuilderRow>
    </t>

    <t t-inherit="website.BuilderOptions" t-inherit-mode="extension">
        <xpath expr="//t[@id='module_specific_options']" position="after">
            <partner_page_option
                template="website_crm_partner_assign.PartnerPageOption"
                selector="main:has(#oe_structure_website_crm_partner_assign_layout_1):not(:has(.o_wcrm_filters_top))"
                title="Partner Page"
                groups='["website.group_website_designer"]'
                editableOnly="false"/>
        </xpath>
    </t>

</templates>
