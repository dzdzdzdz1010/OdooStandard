<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template
        id="website_sale_mass_mailing.newsletter"
        inherit_id="website_sale.address_form_fields"
        name="Newsletter"
        active="False"
    >
         <div id="div_phone" position="after">
            <div t-if="is_anonymous_cart" class="mb-2">
                <label>
                    <input
                        type="checkbox"
                        name="newsletter"
                        class="form-check-input label-optional"
                    /> Subscribe to our newsletter for updates and exclusive offers.
                </label>
            </div>
        </div>
    </template>

    <template id="s_dynamic_products_fragment" inherit_id="mass_mailing_sale.s_dynamic_products_fragment">
        <xpath expr="//a[@target='_blank']" position="attributes">
            <attribute name="t-attf-href">{{record.website_absolute_url or "#"}}</attribute>
        </xpath>
    </template>

    <template id="s_dynamic_product_card_fragment" inherit_id="mass_mailing_sale.s_dynamic_product_card_fragment">
        <xpath expr="//a[@target='_blank']" position="attributes">
            <attribute name="t-attf-href">{{record.website_absolute_url or "#"}}</attribute>
        </xpath>
    </template>

    <template id="s_dynamic_products_aside_fragment" inherit_id="mass_mailing_sale.s_dynamic_products_aside_fragment">
        <xpath expr="//a[@target='_blank']" position="attributes">
            <attribute name="t-attf-href">{{record.website_absolute_url or "#"}}</attribute>
        </xpath>
    </template>
</odoo>
