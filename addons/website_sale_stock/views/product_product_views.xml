<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_product_tree_view_inherit_website_sale_stock" model="ir.ui.view">
        <field name="name">product.product.list.inherit.website.sale.stock</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='qty_available']" position="after">
                <widget name="product_qty_at_date_widget"/>
            </xpath>
        </field>
    </record>
</odoo>
